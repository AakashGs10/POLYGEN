# Copy to .env and fill in ONE provider key. .env is gitignored — never commit it.
# The RAG auto-detects the provider from whichever key is set.

# Option A — Google Gemini (FREE tier). Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B — Anthropic Claude. Get a key: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# POLYGEN_LLM_PROVIDER=google      # or "anthropic" (otherwise auto-detected from the key)
# POLYGEN_LLM_MODEL=gemini-3.8-flash   # or e.g. claude-haiku-5-5
